<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The runner user receives read access to the repository only; the run root is its sole writable area. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.o289.schedule-agent-runner</string>
  <key>UserName</key><string>REPLACE_WITH_RUNNER_USER</string>
  <key>GroupName</key><string>REPLACE_WITH_RUNNER_GROUP</string>
  <key>ProgramArguments</key><array><string>REPLACE_WITH_RUNNER_PROGRAM</string><string>--socket</string><string>REPLACE_WITH_RUNNER_SOCKET</string></array>
  <key>EnvironmentVariables</key><dict><key>RUNNER_REPOSITORY</key><string>REPLACE_WITH_REPOSITORY</string><key>RUNNER_RUN_ROOT</key><string>REPLACE_WITH_RUN_ROOT</string></dict>
  <key>StandardOutPath</key><string>REPLACE_WITH_RUN_ROOT/runner.log</string><key>StandardErrorPath</key><string>REPLACE_WITH_RUN_ROOT/runner.err</string>
  <key>KeepAlive</key><false/>
</dict></plist>
