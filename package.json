{
  "name": "new_schedule_app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "11.20.0"
  },
  "imports": {
    "#backend/*": "./apps/backend/*.ts",
    "#frontend/components/*": "./apps/frontend/components/*.tsx",
    "#frontend/context/*": "./apps/frontend/context/*.tsx",
    "#frontend/pages/*": "./apps/frontend/pages/*.tsx",
    "#frontend/*": "./apps/frontend/*.ts",
    "#config/*": "./packages/config/*",
    "#contracts/*": "./packages/contracts/*.ts",
    "#schemas/*": "./packages/schemas/*.ts",
    "#utils/*": "./packages/utils/*.ts"
  },
  "scripts": {
    "runtime:check": "node tools/check-runtime.mjs",
    "rules:check": "tsx tools/check-project-rules.ts",
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "vite --config vite.config.ts",
    "dev:backend": "tsx watch apps/backend/index.ts",
    "build:frontend": "vite build --config vite.config.ts",
    "build:backend": "vite build --config vite.config.ts --mode backend",
    "typecheck": "pnpm runtime:check && pnpm rules:check && pnpm typecheck:frontend && pnpm typecheck:backend && pnpm typecheck:tools",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "verify:phase": "pnpm typecheck && pnpm test",
    "test:watch": "vitest",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:integration": "vitest run --project backend apps/backend/index.test.ts",
    "e2e:db:up": "docker compose -f compose.e2e.yml up -d --wait",
    "e2e:db:down": "docker compose -f compose.e2e.yml down -v",
    "e2e:backend": "tsx e2e/start-backend.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/luxon3": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@hono/node-server": "2.0.9",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@simplewebauthn/server": "13.3.2",
    "@tanstack/react-query": "5.101.4",
    "clsx": "^2.1.1",
    "dayjs": "1.11.21",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.30",
    "jose": "^6.2.3",
    "luxon": "^3.7.2",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/luxon": "^3.7.2",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "drizzle-kit": "0.31.10",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
